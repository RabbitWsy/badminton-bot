# 复制为 .env 后填写。不要把 .env 提交到仓库。

# 复旦统一认证账号
FUDAN_USERNAME=
FUDAN_PASSWORD=

# 预约信息
FUDAN_PHONE=
FUDAN_VENUE_KEYWORD=江湾综合体育馆-羽毛球
FUDAN_VENUE_URL=https://booking.fudan.edu.cn/reservation/fe/site/reservationInfo?id=1055

# 预约策略
FUDAN_TARGET_DAYS_AHEAD=2
FUDAN_MAX_SLOTS=3
FUDAN_MIN_START_HOUR=15
FUDAN_PREFERRED_SLOTS=21:00-22:30,20:00-21:00,19:00-20:00,18:00-19:00,17:00-18:00,16:00-17:00,15:00-16:00

# 每天 07:00 开放。容器日常循环默认 06:58:30 启动一次任务，脚本会提前进入预约页。
FUDAN_TIMEZONE=Asia/Shanghai
FUDAN_OPEN_TIME=07:00:00
FUDAN_WAIT_UNTIL_OPEN=true
FUDAN_RETRY_UNTIL_SECONDS=90
FUDAN_RETRY_INTERVAL_SECONDS=1
# 空闲检查逐步退避，少量抖动用于避免固定频率刷新；不延迟首次抢场。
FUDAN_RETRY_MAX_INTERVAL_SECONDS=8
FUDAN_RETRY_JITTER_SECONDS=0.3
# 连续确认所有剩余目标时段约满后停止；0 表示继续检查直到重试窗口结束。
FUDAN_FULL_SLOT_CHECKS=3
# 浏览器鼠标按下和释放之间的间隔，单位毫秒。
FUDAN_CLICK_DELAY_MS=60
# 这个系统常有持续网络请求。压短等待，靠文本/控件出现来判断页面是否可用。
FUDAN_PAGE_SETTLE_TIMEOUT_MS=1200
FUDAN_SUBMIT_RESULT_TIMEOUT_MS=10000
# 表格或跨周数据慢时等待加载完成，避免反复刷新中断请求。
FUDAN_BOOKING_READY_TIMEOUT_MS=15000

# booking.fudan.edu.cn 当前会拦截 headless 浏览器。容器里用 scripts/run-daily.sh 时会自动套 xvfb-run。
FUDAN_HEADLESS=false
FUDAN_USE_CDP_BROWSER=true
FUDAN_CDP_STARTUP_ATTEMPTS=3
FUDAN_CDP_STARTUP_TIMEOUT_SECONDS=30
FUDAN_CDP_RETRY_DELAY_SECONDS=1
FUDAN_SLOW_MO_MS=0
# 本地 Mac 如果 Playwright Chromium 下载失败，可临时设置为 chrome 使用系统 Chrome。
FUDAN_BROWSER_CHANNEL=
FUDAN_BROWSER_EXECUTABLE_PATH=
FUDAN_LOG_DIR=logs
